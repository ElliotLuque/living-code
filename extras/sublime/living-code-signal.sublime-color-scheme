{
  "name": "Living Code Signal",
  "author": "Elliot Luque",
  "variables": {
    "crust": "#020405",
    "base": "#05080b",
    "mantle": "#090e11",
    "surface0": "#12171a",
    "surface1": "#1d2226",
    "surface2": "#2d3438",
    "overlay": "#50565b",
    "comment": "#747c80",
    "subtext": "#9ba0a2",
    "text2": "#c8cfd4",
    "text": "#e2e9ee",
    "teal": "#00a692",
    "mint": "#00a692",
    "aqua": "#e2e9ee",
    "steel": "#c8cfd4",
    "amber": "#e2e9ee",
    "copper": "#e2e9ee",
    "flare": "#e2e9ee",
    "moss": "#c8cfd4",
    "orchid": "#00a692",
    "rose": "#c8cfd4",
    "role_bg": "#05080b",
    "role_bgAlt": "#090e11",
    "role_bgDeep": "#020405",
    "role_fg": "#e2e9ee",
    "role_fgAlt": "#c8cfd4",
    "role_fgMuted": "#9ba0a2",
    "role_fgSubtle": "#747c80",
    "role_accent": "#00a692",
    "role_cursor": "#00a692",
    "role_selection": "#2d3438",
    "role_lineHighlight": "#12171a",
    "role_border": "#1d2226",
    "role_borderActive": "#00a692",
    "role_lineNumber": "#50565b",
    "role_lineNumberActive": "#c8cfd4",
    "role_match": "#00a692",
    "role_error": "#e2e9ee",
    "role_warning": "#c8cfd4",
    "role_info": "#c8cfd4",
    "role_hint": "#c8cfd4",
    "role_success": "#c8cfd4",
    "role_added": "#c8cfd4",
    "role_removed": "#e2e9ee",
    "role_modified": "#00a692",
    "role_keyword": "#00a692",
    "role_builtin": "#00a692",
    "role_function": "#e2e9ee",
    "role_string": "#e2e9ee",
    "role_number": "#e2e9ee",
    "role_constant": "#e2e9ee",
    "role_escape": "#e2e9ee",
    "role_regex": "#e2e9ee",
    "role_type": "#c8cfd4",
    "role_namespace": "#c8cfd4",
    "role_operator": "#747c80",
    "role_punctuation": "#50565b",
    "role_decorator": "#00a692",
    "role_tag": "#00a692",
    "role_attribute": "#c8cfd4",
    "role_property": "#c8cfd4",
    "role_variable": "#e2e9ee",
    "role_parameter": "#c8cfd4",
    "role_comment": "#747c80",
    "role_heading": "#00a692",
    "role_link": "#00a692",
    "role_code": "#e2e9ee",
    "role_quote": "#747c80",
    "tint_added": "#191e21",
    "tint_removed": "#1c2024",
    "tint_modified": "#061818",
    "selection_inactive": "#1c2125"
  },
  "globals": {
    "background": "var(role_bg)",
    "foreground": "var(role_fg)",
    "caret": "var(role_cursor)",
    "block_caret": "var(role_cursor)",
    "invisibles": "var(surface1)",
    "line_highlight": "var(role_lineHighlight)",
    "misspelling": "var(role_error)",
    "fold_marker": "var(role_fgSubtle)",
    "minimap_border": "var(role_border)",
    "accent": "var(role_accent)",
    "shadow": "#00000033",
    "shadow_width": 8,
    "gutter": "var(role_bg)",
    "gutter_foreground": "var(role_lineNumber)",
    "gutter_foreground_highlight": "var(role_lineNumberActive)",
    "line_diff_width": 3,
    "line_diff_added": "var(role_added)",
    "line_diff_modified": "var(role_modified)",
    "line_diff_deleted": "var(role_removed)",
    "selection": "var(role_selection)",
    "inactive_selection": "var(selection_inactive)",
    "highlight": "var(role_match)",
    "find_highlight": "var(role_match)",
    "find_highlight_foreground": "var(role_bg)",
    "scroll_highlight": "var(role_match)",
    "scroll_selected_highlight": "var(role_accent)",
    "rulers": "var(surface0)",
    "guide": "var(surface0)",
    "stack_guide": "var(surface1)",
    "active_guide": "var(surface2)",
    "brackets_options": "underline",
    "brackets_foreground": "var(role_accent)",
    "bracket_contents_options": "underline",
    "bracket_contents_foreground": "var(role_fgMuted)",
    "tags_options": "stippled_underline",
    "tags_foreground": "var(role_accent)"
  },
  "rules": [
    {
      "name": "comment",
      "scope": "comment, punctuation.definition.comment, string.quoted.docstring",
      "foreground": "var(role_comment)",
      "font_style": "italic"
    },
    {
      "name": "keyword",
      "scope": "keyword, storage.type, storage.modifier, keyword.control, keyword.operator.new, keyword.operator.expression, keyword.operator.logical.python, keyword.operator.wordlike, keyword.other, punctuation.definition.template-expression, punctuation.section.embedded",
      "foreground": "var(role_keyword)"
    },
    {
      "name": "operator",
      "scope": "keyword.operator, storage.type.function.arrow",
      "foreground": "var(role_operator)"
    },
    {
      "name": "punctuation",
      "scope": "punctuation, meta.brace, punctuation.definition.tag, punctuation.separator, punctuation.terminator, punctuation.accessor",
      "foreground": "var(role_punctuation)"
    },
    {
      "name": "string",
      "scope": "string, punctuation.definition.string, string.template",
      "foreground": "var(role_string)"
    },
    {
      "name": "escape",
      "scope": "constant.character.escape, constant.other.placeholder, constant.character.format",
      "foreground": "var(role_escape)"
    },
    {
      "name": "regex",
      "scope": "string.regexp",
      "foreground": "var(role_regex)"
    },
    {
      "name": "number",
      "scope": "constant.numeric, keyword.other.unit",
      "foreground": "var(role_number)"
    },
    {
      "name": "constant",
      "scope": "constant.language, constant.other, variable.other.constant.property, support.constant, variable.other.enummember, constant.other.color",
      "foreground": "var(role_constant)"
    },
    {
      "name": "function",
      "scope": "entity.name.function, support.function, meta.function-call.generic, variable.function, entity.name.function.member",
      "foreground": "var(role_function)"
    },
    {
      "name": "type",
      "scope": "entity.name.type, entity.name.class, support.type, support.class, entity.other.inherited-class, storage.type.primitive, support.class.component, entity.other.attribute-name.class.css, entity.other.attribute-name.id.css, entity.name.tag.css",
      "foreground": "var(role_type)"
    },
    {
      "name": "namespace",
      "scope": "entity.name.namespace, entity.name.type.module, entity.name.scope-resolution",
      "foreground": "var(role_namespace)"
    },
    {
      "name": "decorator",
      "scope": "meta.decorator, entity.name.function.decorator, punctuation.decorator, storage.type.annotation, meta.attribute, entity.name.function.macro",
      "foreground": "var(role_decorator)"
    },
    {
      "name": "tag",
      "scope": "entity.name.tag",
      "foreground": "var(role_tag)"
    },
    {
      "name": "attribute",
      "scope": "entity.other.attribute-name",
      "foreground": "var(role_attribute)"
    },
    {
      "name": "property",
      "scope": "variable.other.property, variable.other.object.property, support.variable.property, meta.object-literal.key, support.type.property-name, entity.name.tag.yaml, entity.name.tag.toml, support.type.property-name.json",
      "foreground": "var(role_property)"
    },
    {
      "name": "parameter",
      "scope": "variable.parameter, meta.parameter variable",
      "foreground": "var(role_parameter)",
      "font_style": "italic"
    },
    {
      "name": "builtin",
      "scope": "variable.language, support.variable, variable.language.this, variable.language.self, variable.language.super",
      "foreground": "var(role_builtin)",
      "font_style": "italic"
    },
    {
      "name": "variable",
      "scope": "variable, meta.definition.variable, variable.other.readwrite",
      "foreground": "var(role_variable)"
    },
    {
      "name": "heading",
      "scope": "markup.heading, entity.name.section, markup.heading punctuation.definition.heading",
      "foreground": "var(role_heading)",
      "font_style": "bold"
    },
    {
      "name": "markup.bold",
      "scope": "markup.bold",
      "font_style": "bold"
    },
    {
      "name": "markup.italic",
      "scope": "markup.italic",
      "font_style": "italic"
    },
    {
      "name": "link",
      "scope": "markup.underline.link, string.other.link, markup.link",
      "foreground": "var(role_link)",
      "font_style": "underline"
    },
    {
      "name": "code",
      "scope": "markup.inline.raw, markup.fenced_code, markup.raw",
      "foreground": "var(role_code)"
    },
    {
      "name": "quote",
      "scope": "markup.quote",
      "foreground": "var(role_quote)",
      "font_style": "italic"
    },
    {
      "name": "accent",
      "scope": "punctuation.definition.list, markup.list punctuation.definition",
      "foreground": "var(role_accent)"
    },
    {
      "name": "added",
      "scope": "markup.inserted, meta.diff.header.to-file, punctuation.definition.inserted",
      "foreground": "var(role_added)"
    },
    {
      "name": "removed",
      "scope": "markup.deleted, meta.diff.header.from-file, punctuation.definition.deleted",
      "foreground": "var(role_removed)"
    },
    {
      "name": "modified",
      "scope": "markup.changed, punctuation.definition.changed",
      "foreground": "var(role_modified)"
    },
    {
      "name": "fgSubtle",
      "scope": "meta.diff.range, meta.diff.index, meta.separator",
      "foreground": "var(role_fgSubtle)"
    },
    {
      "name": "error",
      "scope": "invalid, invalid.illegal",
      "foreground": "var(role_error)"
    },
    {
      "name": "warning",
      "scope": "invalid.deprecated",
      "foreground": "var(role_warning)"
    },
    {
      "name": "type",
      "scope": "entity.name.struct, entity.name.enum, entity.name.union, entity.name.trait, entity.name.interface, entity.name.impl",
      "foreground": "var(role_type)"
    },
    {
      "name": "constant",
      "scope": "entity.name.constant, variable.other.constant",
      "foreground": "var(role_constant)"
    },
    {
      "name": "keyword",
      "scope": "keyword.operator.word, punctuation.definition.keyword, punctuation.section.interpolation",
      "foreground": "var(role_keyword)"
    },
    {
      "name": "namespace",
      "scope": "support.module",
      "foreground": "var(role_namespace)"
    },
    {
      "name": "decorator",
      "scope": "meta.annotation, variable.annotation, punctuation.definition.annotation, meta.preprocessor, entity.name.label",
      "foreground": "var(role_decorator)"
    },
    {
      "name": "accent",
      "scope": "entity.name.filename.find-in-files",
      "foreground": "var(role_accent)"
    },
    {
      "name": "lineNumber",
      "scope": "constant.numeric.line-number.find-in-files",
      "foreground": "var(role_lineNumber)"
    },
    {
      "name": "markup.underline",
      "scope": "markup.underline",
      "font_style": "underline"
    },
    {
      "name": "diff inserted",
      "scope": "markup.inserted.diff",
      "foreground": "var(role_added)",
      "background": "var(tint_added)"
    },
    {
      "name": "diff deleted",
      "scope": "markup.deleted.diff",
      "foreground": "var(role_removed)",
      "background": "var(tint_removed)"
    },
    {
      "name": "diff changed",
      "scope": "markup.changed.diff",
      "foreground": "var(role_modified)",
      "background": "var(tint_modified)"
    }
  ]
}
