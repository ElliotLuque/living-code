{
  "name": "Living Code Signal",
  "type": "dark",
  "colors": {
    "editor.background": "#05080b",
    "editor.foreground": "#e2e9ee",
    "editor.selectionBackground": "#2d3438",
    "editorLineNumber.foreground": "#50565b",
    "editorLineNumber.activeForeground": "#c8cfd4",
    "terminal.background": "#05080b",
    "focusBorder": "#00a692",
    "terminal.ansiBlack": "#1d2226",
    "terminal.ansiBrightBlack": "#50565b",
    "terminal.ansiRed": "#e2e9ee",
    "terminal.ansiBrightRed": "#e2e9ee",
    "terminal.ansiGreen": "#c8cfd4",
    "terminal.ansiBrightGreen": "#e2e9ee",
    "terminal.ansiYellow": "#e2e9ee",
    "terminal.ansiBrightYellow": "#e2e9ee",
    "terminal.ansiBlue": "#c8cfd4",
    "terminal.ansiBrightBlue": "#e2e9ee",
    "terminal.ansiMagenta": "#c8cfd4",
    "terminal.ansiBrightMagenta": "#e2e9ee",
    "terminal.ansiCyan": "#00a692",
    "terminal.ansiBrightCyan": "#00a692",
    "terminal.ansiWhite": "#9ba0a2",
    "terminal.ansiBrightWhite": "#e2e9ee"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#747c80",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike",
        "keyword.other",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#00a692"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#747c80"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.tag",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#50565b"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.template"
      ],
      "settings": {
        "foreground": "#e2e9ee"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "constant.character.format"
      ],
      "settings": {
        "foreground": "#e2e9ee"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#e2e9ee"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#e2e9ee"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.other",
        "variable.other.constant.property",
        "support.constant",
        "variable.other.enummember",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#e2e9ee"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#e2e9ee"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "support.class.component",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#c8cfd4"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.type.module",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#c8cfd4"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "storage.type.annotation",
        "meta.attribute",
        "entity.name.function.macro"
      ],
      "settings": {
        "foreground": "#00a692"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#00a692"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#c8cfd4"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml",
        "entity.name.tag.toml",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#c8cfd4"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter variable"
      ],
      "settings": {
        "foreground": "#c8cfd4",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.language",
        "support.variable",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#00a692",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#e2e9ee"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section",
        "markup.heading punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#00a692",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#00a692",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#e2e9ee"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#747c80",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "punctuation.definition.list",
        "markup.list punctuation.definition"
      ],
      "settings": {
        "foreground": "#00a692"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#c8cfd4"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#e2e9ee"
      }
    },
    {
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#00a692"
      }
    },
    {
      "scope": [
        "meta.diff.range",
        "meta.diff.index",
        "meta.separator"
      ],
      "settings": {
        "foreground": "#747c80"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e2e9ee"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#c8cfd4"
      }
    }
  ],
  "styleOverrides": {
    "codeBackground": "#05080b",
    "codeForeground": "#e2e9ee",
    "codeSelectionBackground": "#2d3438",
    "borderColor": "#1d2226",
    "focusBorder": "#00a692",
    "gutterBorderColor": "#1d2226",
    "gutterForeground": "#747c80",
    "gutterHighlightForeground": "#c8cfd4",
    "uiSelectionBackground": "#2d3438",
    "uiSelectionForeground": "#e2e9ee",
    "scrollbarThumbColor": "#2d3438",
    "scrollbarThumbHoverColor": "#747c80",
    "frames": {
      "frameBoxShadowCssValue": "none",
      "editorBackground": "#05080b",
      "editorTabBarBackground": "#020405",
      "editorTabBarBorderColor": "#1d2226",
      "editorTabBarBorderBottomColor": "#1d2226",
      "editorActiveTabBackground": "#05080b",
      "editorActiveTabForeground": "#e2e9ee",
      "editorActiveTabBorderColor": "#1d2226",
      "editorActiveTabIndicatorTopColor": "#00a692",
      "editorActiveTabIndicatorBottomColor": "transparent",
      "terminalBackground": "#05080b",
      "terminalTitlebarBackground": "#020405",
      "terminalTitlebarForeground": "#9ba0a2",
      "terminalTitlebarBorderBottomColor": "#1d2226",
      "terminalTitlebarDotsForeground": "#9ba0a2",
      "inlineButtonForeground": "#9ba0a2",
      "inlineButtonBackground": "#9ba0a2",
      "inlineButtonBorder": "#1d2226",
      "tooltipSuccessBackground": "#090e11",
      "tooltipSuccessForeground": "#c8cfd4"
    },
    "textMarkers": {
      "markBackground": "#00a69226",
      "markBorderColor": "#00a692",
      "insBackground": "#c8cfd426",
      "insBorderColor": "#c8cfd4",
      "insDiffIndicatorColor": "#c8cfd4",
      "delBackground": "#e2e9ee26",
      "delBorderColor": "#e2e9ee",
      "delDiffIndicatorColor": "#e2e9ee",
      "lineMarkerLabelColor": "#05080b"
    }
  }
}
