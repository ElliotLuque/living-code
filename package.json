{
  "name": "living-code",
  "version": "0.1.0",
  "description": "A color scheme for editors, terminals and the web.",
  "type": "module",
  "license": "MIT",
  "author": "Elliot Luque",
  "repository": { "type": "git", "url": "git+https://github.com/ElliotLuque/living-code.git" },
  "keywords": ["theme", "colorscheme", "oklch", "neovim", "vscode", "kitty", "ghostty", "shiki"],
  "main": "./palette.mjs",
  "exports": {
    ".": "./palette.mjs",
    "./palette.json": "./palette.json",
    "./extras/*": "./extras/*"
  },
  "files": ["palette.mjs", "palette.json", "extras"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:icons": "node scripts/build.mjs && node scripts/build-icons.mjs",
    "check": "node scripts/build.mjs --check",
    "preview": "node scripts/serve.mjs",
    "recolor": "node scripts/recolor.mjs",
    "test": "node --test scripts/recolor.test.mjs scripts/icons.test.mjs"
  },
  "engines": { "node": ">=18" }
}
