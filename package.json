{
  "name": "living-code",
  "private": true,
  "packageManager": "pnpm@12.9.0",
  "version": "0.1.0",
  "description": "A color scheme for editors, terminals and the web.",
  "type": "module",
  "license": "MIT",
  "author": "Elliot Luque",
  "repository": { "type": "git", "url": "git+https://github.com/ElliotLuque/living-code.git" },
  "keywords": ["theme", "colorscheme", "oklch", "neovim", "vscode", "kitty", "ghostty", "shiki"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:packages": "pnpm run build && node scripts/build-packages.mjs",
    "test:packages": "node --test scripts/npm-packages.test.mjs",
    "check": "node scripts/build.mjs --check",
    "preview": "node scripts/serve.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "recolor": "node scripts/recolor.mjs",
    "test": "node --test scripts/recolor.test.mjs scripts/expressive-code.test.mjs scripts/git.test.mjs scripts/npm-packages.test.mjs scripts/resolve.test.mjs scripts/preview.test.mjs scripts/readme.test.mjs"
  },
  "engines": { "node": ">=18" }
}
